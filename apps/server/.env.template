# =============================================================================
# COESCO Portal Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all values
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
PORT=8080
ENV=development
# ENV options: development | testing | production
LOG_LEVEL=info
# LOG_LEVEL options: error | warn | info | http | debug

# -----------------------------------------------------------------------------
# CORS Origins (production only, comma-separated)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=https://portal.cpec.com,https://test.portal.cpec.com

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/coesco_dev

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Minimum 32 characters - use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Progress OpenEdge ODBC Connection (Legacy Databases)
# -----------------------------------------------------------------------------
ODBC_DRIVER=Progress OpenEdge 12.8 Driver
PROSQL_USER=
PROSQL_PASSWORD=

# Standard Database (STD)
STD_HOST=
STD_PORT=
STD_DB=

# Job Database (JOB)
JOB_HOST=
JOB_PORT=
JOB_DB=

# Quote Database (QUOTE)
QUOTE_HOST=
QUOTE_PORT=
QUOTE_DB=

# -----------------------------------------------------------------------------
# Microsoft Azure AD / Graph API
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8080/v1/auth/microsoft/callback
# Minimum 32 characters - use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GRAPH_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Database Backups
# -----------------------------------------------------------------------------
# Directory to store backups (defaults to ./backups if not set)
# BACKUP_DIR=/opt/coesco/backups
# Number of days to retain backups (default: 14)
BACKUP_RETENTION_DAYS=14
